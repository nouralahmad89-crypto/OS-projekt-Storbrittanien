         "source": [
            "# Filter to medals in Athletics and Cycling\n",
            "multi_sport_medals = df[(df['Sport'].isin(['Athletics', 'Cycling'])) & (df['Medal'].notnull())]\n",
            "\n",
            "# Select Top 10 countries based on medal count in these sports\n",
            "top_countries = multi_sport_medals['NOC'].value_counts().head(10).index\n",
            "top_medals = multi_sport_medals[multi_sport_medals['NOC'].isin(top_countries)]\n",
            "\n",
            "# Group by country, sport and medal type\n",
            "country_sport_medals = top_medals.groupby(['NOC', 'Sport', 'Medal']).size().reset_index(name='Count')\n",
            "\n",
            "# Plot bar chart: one for each sport\n",
            "g = sns.catplot(data=country_sport_medals, x='NOC', y='Count', hue='Medal',\n",
            "                col='Sport', kind='bar', height=5, aspect=1.2)\n",
            "\n",
            "g.set_titles(\"{col_name}\")\n",
            "g.set_axis_labels(\"Country (NOC)\", \"Number of medals\")\n",
            "g._legend.set_title(\"Medal Type\")\n",
            "plt.subplots_adjust(top=0.85)\n",
            "g.fig.suptitle(\"Top 10 Countries by Medal Count in Athletics and Cycling\")\n",
            "plt.show()"
         ]
      },
