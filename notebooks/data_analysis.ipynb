            "top_medal = top10_medals.groupby(['Sport', 'Medal']).size().unstack(fill_value=0)\n",
            "top_medal['total'] = top_medal.sum(axis=1)\n",
            "sorted_top_medal=top_medal.sort_values(by='total', ascending= False)\n",
            "sorted_top_medal"
         ]
      },
